vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
  }
}

direction: right

classes: {
  user: {
    shape: person
    style: {
      fill: "#ffffff"
      stroke: "#334155"
      stroke-width: 2
      font-color: "#0f172a"
      shadow: true
    }
  }

  frontend: {
    style: {
      fill: "#eff6ff"
      stroke: "#3b82f6"
      stroke-width: 2
      font-color: "#1e3a8a"
      border-radius: 12
      shadow: true
    }
  }

  backend: {
    style: {
      fill: "#f0fdf4"
      stroke: "#22c55e"
      stroke-width: 2
      font-color: "#14532d"
      border-radius: 12
      shadow: true
    }
  }

  database: {
    style: {
      fill: "#faf5ff"
      stroke: "#a855f7"
      stroke-width: 2
      font-color: "#581c87"
      border-radius: 12
      shadow: true
    }
  }

  infra: {
    style: {
      fill: "#f8fafc"
      stroke: "#64748b"
      stroke-width: 2
      font-color: "#334155"
      border-radius: 12
      shadow: true
    }
  }

  integration: {
    style: {
      fill: "#fff7ed"
      stroke: "#f97316"
      stroke-width: 2
      font-color: "#7c2d12"
      border-radius: 12
      shadow: true
    }
  }

  group: {
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
      stroke-width: 1
      border-radius: 18
      shadow: true
    }
  }
}

title: RetailSync - Local Development Architecture {
  shape: text
  near: top-center
  style: {
    bold: true
    font-size: 32
    font-color: "#1e293b"
  }
}

subtitle: Docker-based local runtime for the client, API, database, and connected services. {
  shape: text
  near: top-center
  style: {
    font-size: 16
    font-color: "#475569"
  }
}

user_app: {
  label: "User"
  class: user
}

docker_stack: {
  label: "Docker Compose Stack"
  class: group
  direction: down

  client_container: {
    label: "Client Container"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg"
    class: group
    direction: down

    nginx: {
      label: "Nginx"
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nginx/nginx-original.svg"
      class: frontend
    }

    react_app: {
      label: "React SPA Build\n(Vite/TypeScript)"
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vitejs/vitejs-original.svg"
      class: frontend
    }
  }

  server_container: {
    label: "Server Container"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg"
    class: group
    direction: down

    express_server: {
      label: "Node.js / Express API"
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg"
      class: backend
    }
  }

  mongo_container: {
    label: "Mongo Container"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg"
    class: group
    direction: down

    mongo_db: {
      label: "MongoDB"
      shape: cylinder
      icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/mongodb/mongodb-original.svg"
      class: database
    }
  }
}

supporting_services: {
  label: "Supporting Services"
  class: group
  direction: down

  gcs_bucket: {
    label: "Google Cloud Storage Bucket"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/googlecloud/googlecloud-original.svg"
    class: database
  }

  google_auth: {
    label: "Google OAuth"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/google/google-original.svg"
    class: integration
  }

  google_sheets: {
    label: "Google Sheets"
    icon: "https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/google/google-original.svg"
    class: integration
  }

  quickbooks: {
    label: "QuickBooks APIs"
    icon: "https://cdn.simpleicons.org/intuit/236CFF"
    class: integration
  }
}

user_app -> docker_stack.client_container.nginx: "opens web app"

docker_stack.client_container.nginx -> docker_stack.client_container.react_app: "serves static SPA"
docker_stack.client_container.react_app -> docker_stack.client_container.nginx: "calls /api"
docker_stack.client_container.nginx -> docker_stack.server_container.express_server: "reverse proxies /api to server:4000"

docker_stack.server_container.express_server -> docker_stack.mongo_container.mongo_db: "reads / writes app data"
docker_stack.server_container.express_server -> supporting_services.gcs_bucket: "stores statement files and artifacts"

docker_stack.server_container.express_server -> supporting_services.google_auth: "OAuth login / token exchange"
docker_stack.server_container.express_server -> supporting_services.google_sheets: "imports / exports spreadsheet data"
docker_stack.server_container.express_server -> supporting_services.quickbooks: "OAuth + accounting sync"
