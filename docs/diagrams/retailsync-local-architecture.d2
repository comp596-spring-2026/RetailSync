vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 300
  }
}

direction: right

classes: {
  user: {
    shape: person
    style: {
      fill: "#ffffff"
      stroke: "#334155"
      stroke-width: 2
      font-color: "#0f172a"
      shadow: true
    }
  }

  frontend: {
    style: {
      fill: "#eff6ff"
      stroke: "#3b82f6"
      stroke-width: 2
      font-color: "#1e3a8a"
      border-radius: 12
      shadow: true
    }
  }

  backend: {
    style: {
      fill: "#f0fdf4"
      stroke: "#22c55e"
      stroke-width: 2
      font-color: "#14532d"
      border-radius: 12
      shadow: true
    }
  }

  database: {
    style: {
      fill: "#faf5ff"
      stroke: "#a855f7"
      stroke-width: 2
      font-color: "#581c87"
      border-radius: 12
      shadow: true
    }
  }

  infra: {
    style: {
      fill: "#f8fafc"
      stroke: "#64748b"
      stroke-width: 2
      font-color: "#334155"
      border-radius: 12
      shadow: true
    }
  }

  integration: {
    style: {
      fill: "#fff7ed"
      stroke: "#f97316"
      stroke-width: 2
      font-color: "#7c2d12"
      border-radius: 12
      shadow: true
    }
  }

  group: {
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
      stroke-width: 1
      border-radius: 18
      shadow: true
    }
  }
}

title: RetailSync - Local Development Architecture {
  shape: text
  near: top-center
  style: {
    bold: true
    font-size: 32
    font-color: "#1e293b"
  }
}

subtitle: Docker-based local runtime for the client, API, database, and connected services. {
  shape: text
  near: top-center
  style: {
    font-size: 16
    font-color: "#475569"
  }
}

user_app: {
  label: "User"
  class: user
}

docker_stack: {
  label: "Docker Compose Stack"
  class: group
  direction: down

  client_container: {
    label: "Client Container"
    icon: "./icons/docker.svg"
    class: group
    direction: down

    nginx: {
      label: "Nginx"
      icon: "./icons/nginx.svg"
      class: frontend
    }

    react_app: {
      label: "React Static Build\nVite / TypeScript"
      icon: "./icons/vite.svg"
      class: frontend
    }
  }

  server_container: {
    label: "Server Container"
    icon: "./icons/docker.svg"
    class: group
    direction: down

    express_server: {
      label: "Node.js / Express API"
      icon: "./icons/nodejs.svg"
      class: backend
    }
  }

  mongo_container: {
    label: "Mongo Container"
    icon: "./icons/docker.svg"
    class: group
    direction: down

    mongo_db: {
      label: "MongoDB"
      shape: cylinder
      icon: "./icons/mongodb.svg"
      class: database
    }

    mongo_volume: {
      label: "Mongo Volume\nPersistent Local Data"
      class: infra
    }
  }
}

supporting_services: {
  label: "Supporting Services"
  class: group
  direction: down

  gcs_bucket: {
    label: "Google Cloud Storage Bucket"
    icon: "./icons/googlecloud.svg"
    class: database
  }

  google_auth: {
    label: "Google OAuth"
    icon: "./icons/google.svg"
    class: integration
  }

  google_sheets: {
    label: "Google Sheets"
    icon: "./icons/google.svg"
    class: integration
  }

  quickbooks: {
    label: "QuickBooks APIs"
    icon: "./icons/quickbooks.svg"
    class: integration
  }
}

user_app -> docker_stack.client_container.nginx: "opens web app"

docker_stack.client_container.nginx -> docker_stack.client_container.react_app: "serves static SPA"
docker_stack.client_container.react_app -> docker_stack.client_container.nginx: "calls /api"
docker_stack.client_container.nginx -> docker_stack.server_container.express_server: "reverse proxies /api to server:4000"

docker_stack.server_container.express_server -> docker_stack.mongo_container.mongo_db: "reads / writes app data"
docker_stack.mongo_container.mongo_db -> docker_stack.mongo_container.mongo_volume: "persists local data"

docker_stack.server_container.express_server -> supporting_services.gcs_bucket: "stores statement files and artifacts"
docker_stack.server_container.express_server -> supporting_services.google_auth: "OAuth login / token exchange"
docker_stack.server_container.express_server -> supporting_services.google_sheets: "imports / exports spreadsheet data"
docker_stack.server_container.express_server -> supporting_services.quickbooks: "OAuth + accounting sync"
