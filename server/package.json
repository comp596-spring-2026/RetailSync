{
  "name": "@retailsync/server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import tsx src/index.ts",
    "seed:pos": "tsx src/scripts/seedPosSample.ts",
    "db:reset": "tsx src/scripts/resetLocalDatabase.ts",
    "db:cleanup:google-sheets": "tsx src/scripts/cleanupGoogleSheetsDb.ts",
    "backfill:role-permissions": "tsx src/scripts/backfillLegacyRolePermissions.ts",
    "storage:cors:accounting": "tsx src/scripts/setAccountingBucketCors.ts",
    "migrate:accounting": "tsx src/scripts/migrateAccounting.ts",
    "statement:fixture": "tsx src/scripts/runStatementFixtureExtraction.ts",
    "statement:investigate": "tsx src/scripts/runStatementFixtureInvestigation.ts",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude src/**/*.e2e.test.ts --exclude src/**/*.integration.test.ts --exclude src/auth.refresh.test.ts --exclude src/posAndReports.test.ts",
    "test:integration": "vitest run src/auth.refresh.test.ts src/posAndReports.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@napi-rs/canvas": "^0.1.100",
    "@retailsync/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "pdf.js-extract": "^1.0.1",
    "pdfjs-dist": "^5.5.207",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.1.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
